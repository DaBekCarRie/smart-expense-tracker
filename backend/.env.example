# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/expense_tracker

# Docker Compose uses these to initialize the PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expense_tracker

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-byte-hex-value
JWT_SECRET=change-me-to-a-random-32-byte-hex-value
ALGORITHM=HS256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── OCR ─────────────────────────────────────────────────────────────────────
# Options: tesseract | openai | google_vision
OCR_PROVIDER=tesseract
OPENAI_API_KEY=

# ─── CORS ────────────────────────────────────────────────────────────────────
# pydantic-settings parses this as a JSON array
# Dev:        CORS_ORIGINS=["http://localhost:3000"]
# Production: CORS_ORIGINS=["https://smart-expense-tracker-coral.vercel.app"]
CORS_ORIGINS=["http://localhost:3000"]

# Frontend base URL — used in password-reset emails
# Dev:        FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://smart-expense-tracker-coral.vercel.app
FRONTEND_URL=http://localhost:3000

# ─── Misc ────────────────────────────────────────────────────────────────────
# Set true in production (HTTPS) so auth cookies carry the Secure flag
COOKIE_SECURE=false
